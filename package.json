{
  "name": "valheim-character-editor",
  "version": "1.0.0",
  "description": "Real-time character, inventory, live world builder, 3D blueprint viewer, and farm automation suite for Valheim",
  "author": "herdlevar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/herdlevar/valheim-character-editor.git"
  },
  "bugs": {
    "url": "https://github.com/herdlevar/valheim-character-editor/issues"
  },
  "homepage": "https://github.com/herdlevar/valheim-character-editor#readme",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:3000 && cross-env VITE_DEV_SERVER_URL=http://localhost:3000 electron .\"",
    "app": "npm run build && electron .",
    "build:mod": "powershell -ExecutionPolicy Bypass -File ./build_and_install_mod.ps1"
  },
  "dependencies": {
    "@types/js-sha512": "^0.7.0",
    "@types/three": "^0.186.0",
    "express": "^4.21.2",
    "js-sha512": "^0.9.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^9.1.0"
  }
}
